// Firestore Security Rules — da incollare in Firebase Console →
// Firestore Database → Regole, oppure da pubblicare con la Firebase CLI.
//
// Stesso pattern usato nella versione Supabase: lettura per chiunque sia
// autenticato, scrittura di registrazioni operative libera per chi è
// autenticato, modifica di configurazione/approvazione riservata al ruolo
// "responsabile".

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticato() {
      return request.auth != null;
    }

    function ruolo() {
      return get(/databases/$(database)/documents/profili/$(request.auth.uid)).data.ruolo;
    }

    function eResponsabile() {
      return autenticato() && ruolo() == 'responsabile';
    }

    match /profili/{uid} {
      allow read: if autenticato() && (request.auth.uid == uid || eResponsabile());
      allow write: if false;
    }

    match /attrezzature/{id} {
      allow read: if autenticato();
      allow write: if eResponsabile();
    }
    match /piano_pulizie/{id} {
      allow read: if autenticato();
      allow write: if eResponsabile();
    }
    match /procedure_approvate/{id} {
      allow read: if autenticato();
      allow write: if eResponsabile();
    }

    match /rilevazioni_temperatura/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      allow update, delete: if false;
    }
    match /registrazioni_processo/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      allow update, delete: if false;
    }
    match /registrazioni_pulizia/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      allow update, delete: if false;
    }
    match /non_conformita/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.aperto_da == request.auth.uid;
      allow update: if autenticato();
      allow delete: if false;
    }
    match /conservazioni/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      allow update, delete: if false;
    }
    match /servizi/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      allow update, delete: if false;
    }
    match /ricevimenti/{id} {
      allow read: if autenticato();
      allow create: if autenticato() && request.resource.data.registrato_da == request.auth.uid;
      // Un ricevimento già registrato non può essere modificato liberamente.
      // È consentita soltanto la correzione della data riportata sul DDT.
      allow update: if autenticato()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data_documento']);
      allow delete: if false;
    }

    match /prodotti/{id} {
      allow read: if autenticato();
      allow write: if autenticato();
    }
    match /fornitori/{id} {
      allow read: if autenticato();
      allow write: if autenticato();
    }
    match /listino_prezzi/{id} {
      allow read: if autenticato();
      allow write: if autenticato();
    }
    match /schede_haccp/{id} {
      allow read: if autenticato();
      allow create: if autenticato();
      allow update: if autenticato() && (
        request.resource.data.stato != 'approvata' || eResponsabile()
      );
      allow delete: if autenticato() && resource.data.stato != 'approvata';
    }
    match /documenti/{id} {
      allow read: if autenticato();
      allow write: if autenticato();
    }
    match /audit_log/{id} {
      allow read: if eResponsabile();
      allow create: if autenticato();
      allow update, delete: if false;
    }
  }
}
