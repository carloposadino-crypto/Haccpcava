{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/parse-recipe",
      "destination": "/api/parse-recipe.js"
    }
  ]
}